<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>防犯カメラ日報 — {{ report.date }}</title>
  <style>
    :root { color-scheme: light; --ink:#17212b; --muted:#607080; --line:#d9e1e8; --paper:#fff; --wash:#f4f7f9; --accent:#1f607a; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--wash); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif; line-height:1.75; }
    main { max-width:920px; margin:32px auto; padding:40px 48px; background:var(--paper); border:1px solid var(--line); border-radius:14px; box-shadow:0 8px 30px rgba(20,40,55,.06); }
    h1 { margin:0; font-size:2rem; letter-spacing:.02em; }
    .date { color:var(--muted); margin:.25rem 0 2rem; }
    h2 { margin-top:2.25rem; padding-bottom:.35rem; border-bottom:2px solid var(--line); color:var(--accent); }
    h3 { margin-bottom:.3rem; }
    ul { padding-left:1.4rem; }
    .event,.period { padding:1rem 1.2rem; margin:1rem 0; border-left:4px solid #8db5c5; background:#f8fafb; border-radius:0 8px 8px 0; }
    .meta { color:var(--muted); font-size:.94rem; overflow-wrap:anywhere; }
    .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:.75rem; }
    .stat { padding:.8rem; border:1px solid var(--line); border-radius:8px; text-align:center; }
    .stat strong { display:block; font-size:1.5rem; }
    table { width:100%; border-collapse:collapse; }
    th,td { text-align:left; padding:.6rem; border-bottom:1px solid var(--line); vertical-align:top; }
    @media (max-width:650px) { main { margin:0; border:0; border-radius:0; padding:24px 20px; } }
    @media print { body { background:white; } main { margin:0; border:0; box-shadow:none; max-width:none; } }
  </style>
</head>
<body><main>
  <h1>防犯カメラ日報</h1>
  <p class="date">{{ report.date_ja }}</p>

  <section><h2>本日の概要</h2><p>{{ report.overview }}</p></section>

  {% if report.recurring_patterns %}<section><h2>全体に見られた様子</h2><ul>{% for item in report.recurring_patterns %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}

  {% if report.time_periods %}<section><h2>時間帯別の様子</h2>
  {% for period in report.time_periods %}<article class="period"><h3>{{ period.label }}</h3><p>{{ period.summary }}</p>{% if period.event_ids %}<p class="meta">参照イベント: {{ period.event_ids | join(', ') }}</p>{% endif %}</article>{% endfor %}
  </section>{% endif %}

  {% if report.representative_events %}<section><h2>個別に記録された出来事</h2>
  {% for event in report.representative_events %}<article class="event"><h3>{% if event.recording_time %}{{ event.recording_time_display }}ごろ{% else %}録画時刻: 不明{% endif %}</h3><p class="meta">元動画: {{ event.source_file }}<br>イベントID: {{ event.event_id }}</p><p>{{ event.description }}</p></article>{% endfor %}
  </section>{% endif %}

  <section><h2>解析状況</h2><div class="stats">
    <div class="stat"><strong>{{ report.processing.detected_files }}</strong>動画</div>
    <div class="stat"><strong>{{ report.processing.succeeded }}</strong>正常解析</div>
    <div class="stat"><strong>{{ report.processing.cached }}</strong>キャッシュ再利用</div>
    <div class="stat"><strong>{{ report.processing.unstable }}</strong>転送中保留</div>
    <div class="stat"><strong>{{ report.processing.failed }}</strong>失敗</div>
  </div>
  {% if report.failed_events %}<h3>解析できなかった動画</h3><table><thead><tr><th>録画時刻</th><th>元動画</th><th>エラー</th></tr></thead><tbody>{% for f in report.failed_events %}<tr><td>{% if f.recording_time %}{{ f.recording_time_display }}{% else %}不明{% endif %}</td><td>{{ f.source_file }}</td><td>{{ f.error }}</td></tr>{% endfor %}</tbody></table>{% endif %}
  </section>
</main></body></html>
