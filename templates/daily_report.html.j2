<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>防犯カメラ日報 — {{ report.date }}</title>
  <style>
    :root { color-scheme: light; --ink:#17212b; --muted:#607080; --line:#d9e1e8; --paper:#fff; --wash:#f4f7f9; --accent:#1f607a; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--wash); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif; line-height:1.75; }
    main { max-width:920px; margin:32px auto; padding:40px 48px; background:var(--paper); border:1px solid var(--line); border-radius:14px; box-shadow:0 8px 30px rgba(20,40,55,.06); }
    h1 { margin:0; font-size:2rem; letter-spacing:.02em; }
    .date { color:var(--muted); margin:.25rem 0 2rem; }
    h2 { margin-top:2.25rem; padding-bottom:.35rem; border-bottom:2px solid var(--line); color:var(--accent); }
    h3 { margin-bottom:.3rem; }
    ul { padding-left:1.4rem; }
    .event,.period { padding:1rem 1.2rem; margin:1rem 0; border-left:4px solid #8db5c5; background:#f8fafb; border-radius:0 8px 8px 0; }
    .banner { display:flex; align-items:baseline; gap:.6rem; padding:.9rem 1.1rem; margin:0 0 1.5rem; border-radius:10px; font-size:1.05rem; }
    .banner strong { font-size:1.35rem; }
    .banner.clear { background:#eef5f0; border:1px solid #bcd8c6; color:#245c3a; }
    .banner.flagged { background:#fdf1e7; border:1px solid #e8c39b; color:#8a4b12; }
    .banner.failed { background:#f6f0f2; border:1px solid #d8bcc4; color:#7a2f43; }
    .attention { padding:1rem 1.2rem; margin:1rem 0; border-left:4px solid #d98b45; background:#fdf7f2; border-radius:0 8px 8px 0; }
    .attention .notable { font-weight:700; }
    .score { display:inline-block; padding:.1rem .55rem; border-radius:999px; background:#e6ac74; color:#3a1f08; font-size:.85rem; margin-left:.4rem; }
    .meta { color:var(--muted); font-size:.94rem; overflow-wrap:anywhere; }
    .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:.75rem; }
    .stat { padding:.8rem; border:1px solid var(--line); border-radius:8px; text-align:center; }
    .stat strong { display:block; font-size:1.5rem; }
    table { width:100%; border-collapse:collapse; }
    th,td { text-align:left; padding:.6rem; border-bottom:1px solid var(--line); vertical-align:top; }
    @media (max-width:650px) { main { margin:0; border:0; border-radius:0; padding:24px 20px; } }
    @media print { body { background:white; } main { margin:0; border:0; box-shadow:none; max-width:none; } }
  </style>
</head>
<body><main>
  <h1>防犯カメラ日報</h1>
  <p class="date">{{ report.date_ja }}</p>

  {% if report.triage.missing %}<p class="banner failed"><strong>一部判定欠落</strong> 未評価の{{ report.triage.missing }}件は、安全のため要確認に含めています。</p>
  {% elif report.triage.failed %}<p class="banner failed"><strong>判定失敗</strong> 要確認の抽出ができませんでした。以下は判定なしの記録です。</p>
  {% elif report.triage.enabled and report.triage.evaluated %}<p class="banner {% if report.triage.attention %}flagged{% else %}clear{% endif %}"><strong>要確認 {{ report.triage.attention }}件</strong> / 判定済み {{ report.triage.evaluated }}件</p>
  {% elif report.triage.enabled %}<p class="banner failed"><strong>判定なし</strong> 要確認の判定は行われませんでした。</p>{% endif %}

  <section><h2>本日の概要</h2><p>{{ report.overview }}</p></section>

  {% if report.attention_items %}<section><h2>要確認</h2>
  {% for item in report.attention_items %}<article class="attention"><h3>{% if item.recording_time %}{{ item.recording_time_display }}{% else %}録画時刻不明{% endif %}<span class="score">異常度 {{ item.anomaly_score }}/10</span><span class="score">{{ item.person_type_label }}</span></h3>{% if item.notable %}<p class="notable">{{ item.notable }}</p>{% endif %}<p>{{ item.assessment }}</p>{% if item.routine_explanation %}<p class="meta">普段との対応: {{ item.routine_explanation }}</p>{% endif %}<p class="meta">元動画: {{ item.source_file }}<br>イベントID: {{ item.event_id }}{% if item.related_event_ids %}<br>同じ出来事の関連動画: {{ item.related_event_ids | length }}件（{{ item.related_event_ids | join(', ') }}）{% endif %}</p></article>{% endfor %}
  </section>{% elif report.triage.enabled and report.triage.evaluated and not report.triage.failed %}<section><h2>要確認</h2><p>該当なし。判定した{{ report.triage.evaluated }}件はいずれも平常の範囲でした。</p></section>{% endif %}

  {% if report.day_notes %}<section><h2>その日全体の所見</h2><ul>{% for note in report.day_notes %}<li>{{ note }}</li>{% endfor %}</ul></section>{% endif %}

  {% if report.recurring_patterns %}<section><h2>全体に見られた様子</h2><ul>{% for item in report.recurring_patterns %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}

  {% if report.time_periods %}<section><h2>時間帯別の様子</h2>
  {% for period in report.time_periods %}<article class="period"><h3>{{ period.label }}</h3><p>{{ period.summary }}</p>{% if period.event_ids %}<p class="meta">参照イベント: {{ period.event_ids | join(', ') }}</p>{% endif %}</article>{% endfor %}
  </section>{% endif %}

  {% if report.representative_events %}<section><h2>個別に記録された出来事</h2>
  {% for event in report.representative_events %}<article class="event"><h3>{% if event.recording_time %}{{ event.recording_time_display }}ごろ{% else %}録画時刻: 不明{% endif %}</h3><p class="meta">元動画: {{ event.source_file }}<br>イベントID: {{ event.event_id }}</p><p>{{ event.description }}</p></article>{% endfor %}
  </section>{% endif %}

  <section><h2>解析状況</h2><div class="stats">
    <div class="stat"><strong>{{ report.processing.detected_files }}</strong>動画</div>
    <div class="stat"><strong>{{ report.processing.succeeded }}</strong>正常解析</div>
    <div class="stat"><strong>{{ report.processing.cached }}</strong>キャッシュ再利用</div>
    <div class="stat"><strong>{{ report.processing.unstable }}</strong>転送中保留</div>
    <div class="stat"><strong>{{ report.processing.failed }}</strong>失敗</div>
    <div class="stat"><strong>{{ report.triage.evaluated }}</strong>triage評価</div>
    <div class="stat"><strong>{{ report.triage.missing }}</strong>triage未評価</div>
  </div>
  {% if report.triage.person_type_totals %}<p class="meta">人物判定内訳: {% for key, count in report.triage.person_type_totals.items() %}{{ key }}={{ count }}{% if not loop.last %} / {% endif %}{% endfor %}（抽出閾値 {{ report.triage.threshold }}）<br>同一の出来事としてまとめた件数: {{ report.triage.grouped }}件 / 普段の行動として説明がついた件数: {{ report.triage.routine_explained }}件</p>{% endif %}
  {% if report.failed_events %}<h3>解析できなかった動画</h3><table><thead><tr><th>録画時刻</th><th>元動画</th><th>エラー</th></tr></thead><tbody>{% for f in report.failed_events %}<tr><td>{% if f.recording_time %}{{ f.recording_time_display }}{% else %}不明{% endif %}</td><td>{{ f.source_file }}</td><td>{{ f.error }}</td></tr>{% endfor %}</tbody></table>{% endif %}
  </section>
</main></body></html>
