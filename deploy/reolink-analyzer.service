[Unit]
Description=Reolink daily semantic observation (one-shot container)
Documentation=file:///opt/reolink-analyzer/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/reolink-analyzer/docker-compose.yml
ConditionPathExists=/opt/reolink-analyzer/.env

[Service]
Type=oneshot
User=reolink
Group=reolink
WorkingDirectory=/opt/reolink-analyzer
ExecStart=/usr/bin/flock /opt/reolink-analyzer/.deploy.lock /usr/bin/docker -H unix:///var/run/docker.sock compose --project-directory /opt/reolink-analyzer --env-file /opt/reolink-analyzer/.env -f /opt/reolink-analyzer/docker-compose.yml run --rm analyzer
UMask=0027

# The lock is shared with the root-owned deployment helper. The dedicated
# service user must retain only the groups and Docker access required by the
# production configuration.
