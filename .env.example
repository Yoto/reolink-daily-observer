# Mount the common root; both YYYY/MM/DD and YYYY-MM-DD layouts are supported.
CAMERA_INPUT_DIR=/srv/reolink
ANALYSIS_OUTPUT_DIR=/srv/reolink-analysis/output
ANALYSIS_STATE_DIR=/srv/reolink-analysis/state

# Set these to `id -u` and `id -g` for the dedicated Docker execution user.
ANALYZER_UID=10001
ANALYZER_GID=10001

# Linux host groups grant only the mounts each service needs. Camera files and
# parent directories must be group-readable/searchable by CAMERA_GID; analyzer
# output must be group-readable/searchable by ANALYSIS_GID.
CAMERA_GID=10010
# Match ANALYZER_GID so newly-created reports inherit the group the viewer uses.
ANALYSIS_GID=10001
VIEWER_UID=10002
VIEWER_GID=10002
NGINX_UID=10003
NGINX_GID=10003

# 0027 creates group-readable reports without making camera-derived data
# world-readable. Keep the .env file itself mode 600 on Linux.
ANALYZER_UMASK=0027

# Browser entry point and input day-directory convention. Use "flat" when MP4
# files live below YYYY-MM-DD instead of YYYY/MM/DD.
VIEWER_HTTP_PORT=80
CAMERA_DATE_LAYOUT=nested

# The preview stack binds to localhost by default. Set PREVIEW_HTTP_HOST to
# 0.0.0.0 only when the host firewall restricts port 8081 to a trusted LAN.
PREVIEW_HTTP_HOST=127.0.0.1
PREVIEW_HTTP_PORT=8081

GENAI_PROVIDER=openai
GENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=replace-with-your-openai-api-key

# Event observation goes through the Batch API: half the price, but the daily
# run then waits for the bulk queue (up to 24h). Set to false, or pass --sync,
# when a same-day report matters more than the discount.
GENAI_BATCH_ENABLED=true

# Container /tmp holds the extracted frames. A batched day keeps every
# unprocessed clip's frames until the batch is sent, so this is sized for a
# whole day. It is RAM-backed.
ANALYZER_TMPFS_SIZE=4g

LOG_LEVEL=INFO
