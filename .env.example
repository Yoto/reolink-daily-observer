# Use forward slashes or quote paths containing spaces on Windows.
# Mount the common root; both YYYY/MM/DD and YYYY-MM-DD layouts are supported.
CAMERA_INPUT_DIR=C:/reolink
ANALYSIS_OUTPUT_DIR=C:/reolink-analysis/output
ANALYSIS_STATE_DIR=C:/reolink-analysis/state

# Docker Desktop can keep these defaults. On Linux set them to `id -u` and
# `id -g` for the dedicated Docker execution user.
ANALYZER_UID=10001
ANALYZER_GID=10001

GENAI_PROVIDER=openai
GENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=replace-with-your-openai-api-key
LOG_LEVEL=INFO
